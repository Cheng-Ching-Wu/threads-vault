{
  "name": "threads-vault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Threads 收藏分類管理 App（Vue 3 + Ionic + Capacitor）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "import:cli": "tsx --tsconfig tsconfig.node.json scripts/import-cli.ts",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android && cap open android",
    "test:firestore": "node scripts/test-firestore.mjs --testTimeout=30000"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@ionic/vue": "^9.0.8",
    "@ionic/vue-router": "^9.0.8",
    "firebase": "12.19.0",
    "idb": "^8.0.4",
    "ionicons": "^8.1.0",
    "papaparse": "^5.7.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "^6.2.6",
    "firebase-tools": "15.32.1",
    "jiti": "^2.7.0",
    "sql.js": "^1.15.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
